{
  "name": "calm-corner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier --check . && eslint && tsc --noEmit && markdownlint-cli2 \"content/**/*.mdx\"",
    "format": "prettier --write . && eslint --fix && markdownlint-cli2 --fix \"content/**/*.mdx\"",
    "test": "vitest run",
    "update": "pnpm dlx npm-check-updates -u --reject eslint-plugin-mdx,markdownlint-cli2,typescript && pnpm install && pnpm audit --fix"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@tailwindcss/typography": "^0.5.20",
    "acorn": "^8.19.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.71.0",
    "markdownlint-cli2": "^0.24.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "markdown-it@<15.0.3": "^15.0.3",
      "smol-toml@<1.9.0": "^1.9.0",
      "katex@<0.18.2": "^0.18.2",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "re2js@<2.8.7": "^2.8.7",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=9.0.0 <11.0.1": "^11.0.1"
    }
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/estree": "^1.0.10",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.9.4",
    "jsdom": "^30.1.3",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "xml2js": "^0.6.2"
  }
}
